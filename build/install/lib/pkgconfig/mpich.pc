# this gives access to the mpich header files
prefix=/home/nkodkani/mpich/build/install
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: mpich
Description: High Performance and portable MPI
Version: 5.0.0a1
URL: http://www.mcs.anl.gov/research/projects/mpich
Requires:
Libs: -Wl,-rpath -Wl,${exec_prefix}/lib -Wl,--enable-new-dtags -Wl,-rpath,/home/nkodkani/ucx/build/install/lib -Wl,-rpath,/soft/compilers/rocm/rocm-6.3.2/lib -L${libdir} -lmpi   -Wl,-rpath,/home/nkodkani/ucx/build/install/lib -Wl,-rpath,/soft/compilers/rocm/rocm-6.3.2/lib  -L/home/nkodkani/ucx/build/install/lib -L/soft/compilers/rocm/rocm-6.3.2/lib -ldl -lpthread   -lamdhip64   -lucc -lucp -lucs
Cflags:   -I${includedir}

# pkg-config does not understand Cxxflags, etc. So we allow users to
# query them using the --variable option

cxxflags=  -I${includedir}
fflags= -I${includedir}
fcflags= -I${includedir}
